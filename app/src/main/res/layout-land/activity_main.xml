<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- Speed display on left -->

    <ImageButton
        android:id="@+id/btnSettings"
        style="@style/Widget.App.ImageButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_settings_material"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/imgBtnGallery"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <ImageButton
        android:id="@+id/imgBtnGallery"
        style="@style/Widget.App.ImageButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_gallery_material"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btnRecordAndStop"
        app:layout_constraintStart_toStartOf="@+id/btnSettings"
        app:layout_constraintTop_toBottomOf="@+id/btnSettings" />

    <View
        android:id="@+id/btnRecordAndStop"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_record_button"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/imgBtnGallery"
        app:layout_constraintTop_toBottomOf="@+id/imgBtnGallery" />

    <TextView
        android:id="@+id/tvSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_speed_display"
        android:padding="8dp"
        android:text="-- mph"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/cardView"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- Vertical divider on right side -->

    <!-- Camera preview takes most of the screen -->

    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgBtnGallery"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/tvSpeed">

        <!-- Single camera preview (visible by default) -->
        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Camera2 preview for background recording -->
        <SurfaceView
            android:id="@+id/camera2Preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Dual camera preview container (hidden by default) -->
        <LinearLayout
            android:id="@+id/dualPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/md_theme_surfaceVariant"
                android:gravity="center"
                android:text="Back Camera" />

            <androidx.camera.view.PreviewView
                android:id="@+id/viewFinderBack"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/md_theme_surfaceVariant"
                android:gravity="center"
                android:text="Front Camera" />

            <androidx.camera.view.PreviewView
                android:id="@+id/viewFinderFront"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Gallery button (top of vertical stack) -->

    <!-- Settings button (middle of vertical stack) -->

    <!-- Record button (bottom of vertical stack) -->

</androidx.constraintlayout.widget.ConstraintLayout>
